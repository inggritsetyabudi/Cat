# Migration-only SDK boundary; default builds never discover or link LLVM.
if(CMAKE_CROSSCOMPILING OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR
   NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR
   NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    message(FATAL_ERROR "CLAW_ENABLE_LLVM_OBJECT currently requires native Linux x86_64; other platforms are not validated")
endif()
set(CLAW_LLVM_CONFIG "" CACHE FILEPATH "Explicit path to LLVM 23.1.3 llvm-config")
if(NOT CLAW_LLVM_CONFIG OR NOT IS_ABSOLUTE "${CLAW_LLVM_CONFIG}" OR NOT EXISTS "${CLAW_LLVM_CONFIG}")
    message(FATAL_ERROR "CLAW_ENABLE_LLVM_OBJECT requires an explicit absolute CLAW_LLVM_CONFIG path to LLVM 23.1.3")
endif()
function(cat_object_sdk_query result)
    execute_process(COMMAND "${CLAW_LLVM_CONFIG}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cat LLVM SDK query ${ARGN} failed (${status}): ${error}")
    endif()
    set(${result} "${output}" PARENT_SCOPE)
endfunction()
cat_object_sdk_query(version --version)
if(NOT version STREQUAL "23.1.3")
    message(FATAL_ERROR "Cat native object migration requires exact LLVM 23.1.3; got '${version}'")
endif()
cat_object_sdk_query(headers --includedir)
cat_object_sdk_query(host --host-target)
cat_object_sdk_query(rtti --has-rtti)
cat_object_sdk_query(flags --cppflags)
cat_object_sdk_query(archives --link-static --libfiles core asmparser passes codegen mc target x86codegen x86desc x86info)
cat_object_sdk_query(system_libs --link-static --system-libs)
if(NOT host MATCHES "^x86_64.*linux.*gnu" OR NOT EXISTS "${headers}/llvm/Config/llvm-config.h")
    message(FATAL_ERROR "Cat native object SDK must provide native GNU/Linux x86_64 headers and archives")
endif()
file(READ "${headers}/llvm/Config/llvm-config.h" header_contract)
if(NOT header_contract MATCHES "#define LLVM_VERSION_STRING \"23\\.1\\.3\"")
    message(FATAL_ERROR "Cat native object SDK headers do not match LLVM 23.1.3")
endif()
separate_arguments(archive_list NATIVE_COMMAND "${archives}")
if(NOT archive_list)
    message(FATAL_ERROR "Cat native object SDK returned no LLVM component archives")
endif()
foreach(archive IN LISTS archive_list)
    if(NOT IS_ABSOLUTE "${archive}" OR NOT EXISTS "${archive}" OR
       NOT archive MATCHES "libLLVM[^/]+\\.a$" OR archive MATCHES "\\.dll\\.a$")
        message(FATAL_ERROR "Cat native object SDK requires existing explicit static LLVM component archives: ${archive}")
    endif()
endforeach()
add_library(claw_native_object STATIC src/codegen/native_object.cpp)
target_include_directories(claw_native_object PRIVATE src)
target_include_directories(claw_native_object SYSTEM PRIVATE "${headers}")
if(rtti STREQUAL "NO")
    target_compile_options(claw_native_object PRIVATE -fno-rtti)
elseif(NOT rtti STREQUAL "YES")
    message(FATAL_ERROR "Cat native object SDK returned unknown RTTI contract '${rtti}'")
endif()
separate_arguments(flag_list NATIVE_COMMAND "${flags}")
foreach(flag IN LISTS flag_list)
    if(flag STREQUAL "-fno-exceptions")
        message(FATAL_ERROR "Cat native object boundary requires C++ exceptions")
    elseif(flag MATCHES "^-D(.+)$")
        target_compile_definitions(claw_native_object PRIVATE "${CMAKE_MATCH_1}")
    elseif(NOT flag MATCHES "^-I")
        target_compile_options(claw_native_object PRIVATE "${flag}")
    endif()
endforeach()
separate_arguments(system_list NATIVE_COMMAND "${system_libs}")
target_link_libraries(claw_native_object PRIVATE
    "-Wl,--start-group" ${archive_list} "-Wl,--end-group" ${system_list})
target_link_libraries(claw PRIVATE claw_native_object)
target_compile_definitions(claw PRIVATE CLAW_ENABLE_LLVM_OBJECT=1)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/native-object-sdk.txt"
    "llvm-config=${CLAW_LLVM_CONFIG}\nversion=${version}\nheaders=${headers}\nhost=${host}\nrtti=${rtti}\narchives=${archives}\nsystem-libraries=${system_libs}\n")
message(STATUS "Cat native object bridge: exact LLVM ${version}; ${host}; migration only")

include(CTest)
if(BUILD_TESTING)
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    add_executable(claw-native-object-tests tests/native/native_object_tests.cpp)
    target_include_directories(claw-native-object-tests PRIVATE src)
    target_link_libraries(claw-native-object-tests PRIVATE claw_native_object claw_frontend)
    add_test(NAME native-object-api COMMAND claw-native-object-tests
        "${CMAKE_CURRENT_BINARY_DIR}/native-object-api-artifacts")
    add_test(NAME native-object-integration COMMAND "${Python3_EXECUTABLE}"
        "${PROJECT_SOURCE_DIR}/tests/native/run_llvm_object_tests.py"
        --compiler "$<TARGET_FILE:claw>"
        --artifacts "${CMAKE_CURRENT_BINARY_DIR}/native-object-integration-artifacts")
    set_tests_properties(native-object-api native-object-integration PROPERTIES TIMEOUT 240)
endif()
