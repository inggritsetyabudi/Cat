choice Route {
    left(value: Int32)
    right(value: Int32)
}

choice ByteRoute {
    left(value: UInt8)
    right(value: UInt8)
}

choice TextRoute {
    left(value: String)
    right(value: String)
}

fn bump(value: Int32) -> Int32 {
    value + 1
}

fn choose_number(flag: Bool) -> Int32 {
    if flag {
        30
    } else {
        40
    }
}

fn choose_byte(flag: Bool) -> UInt8 {
    if flag {
        7
    } else {
        8
    }
}

fn take_byte(value: UInt8) -> UInt8 {
    value
}

fn choose_text(flag: Bool) -> String {
    if flag {
        String.from("owned-left")
    } else {
        String.from("owned-right")
    }
}

fn pick_number(route: Route) -> Int32 {
    pick route {
        left(value) {
            value
        }
        right(value) {
            value + 100
        }
    }
}

fn pick_byte(route: ByteRoute) -> UInt8 {
    pick route {
        left(value) {
            value
        }
        right(value) {
            value + 1
        }
    }
}

fn pick_text(route: TextRoute) -> String {
    pick route {
        left(value) {
            value
        }
        right(value) {
            value
        }
    }
}

fn consume_text(value: String) -> Int32 {
    println(value)
    1
}

fn mark(value: Int32) -> Int32 {
    println("mark")
    value
}

fn terminal_if() {
    val never = if true {
        return
    } else {
        return
    }
    println("after-if-never")
}

fn terminal_pick(route: Route) {
    val never = pick route {
        left(value) {
            return
        }
        right(value) {
            return
        }
    }
    println("after-pick-never")
}

fn direct_pick_left() {
    val route: Route = left(10)
    println(pick route {
        left(value) {
            value
        }
        right(value) {
            value + 100
        }
    })
}

fn direct_pick_right() {
    val route: Route = right(10)
    println(pick route {
        left(value) {
            value
        }
        right(value) {
            value + 100
        }
    })
}

fn direct_byte_pick() {
    val route: ByteRoute = left(13)
    println(take_byte(pick route {
        left(value) {
            value
        }
        right(value) {
            value + 1
        }
    }))
}

fn main() {
    println(if true {
        1
    } else {
        0
    })
    println(bump(if false {
        1
    } else {
        2
    }))
    println(if true {
        bump(if false {
            3
        } else {
            4
        })
    } else {
        bump(5)
    })
    println(if false {
        choose_number(true)
    } else {
        choose_number(false)
    })
    println(choose_byte(true))
    println(choose_byte(false))
    println(pick_number(left(9)))
    println(pick_number(right(9)))
    direct_pick_left()
    direct_pick_right()
    println(take_byte(if true {
        11
    } else {
        12
    }))
    direct_byte_pick()
    println(if false {
        pick_number(left(20))
    } else {
        pick_number(right(20))
    })
    println(mark(if true {
        21
    } else {
        22
    }))
    terminal_if()
    terminal_pick(left(1))
    println(consume_text(if true {
        String.from("if-owned-left")
    } else {
        String.from("if-owned-right")
    }))
    println(consume_text(pick_text(left(String.from("pick-owned-left")))))
    println(consume_text(pick_text(right(String.from("pick-owned-right")))))
    println(pick_text(left(String.from("borrowed-left"))))
    println(pick_text(right(String.from("borrowed-right"))))
    println(choose_text(false))
    direct_nested(left(2), true)
    direct_nested(right(3), false)
    direct_owned(true)
    direct_owned(false)
    direct_never(true)
    direct_never(false)
    direct_pick_never(left(4))
    direct_pick_never(right(5))
    direct_all_never()
    print(if true { "print-if" } else { "wrong" })
    val route: Route = right(6)
    print(pick route { left(value) { "wrong" } right(value) { "-pick" } })
    println("")
    println(tuple_value(if true { (2, 3) } else { (4, 5) }))
    println(tuple_value(pick route { left(value) { (6, 7) } right(value) { (8, 9) } }))
    println(array_value(if false { [2, 3] } else { [4, 5] }))
    println(array_value(pick route { left(value) { [6, 7] } right(value) { [8, 9] } }))
    println(42)
    println(1.5)
    println(if false { 2.5 } else { 3.5 })
    val owner = Anchor.new(23)
    println(owner.get())
    print_scalar_ref(owner.get())
    val printer = Printer { value: 0 }
    println(printer.println((24, 25)))
    println(1.5_Float32)
    val float_alias: Float = 4.5
    println(if true { float_alias } else { float_alias })
    println(pick route { left(value) { 6.5 } right(value) { 7.5 } })
}

fn direct_nested(route: Route, flag: Bool) {
    println(if flag {
        pick route { left(value) { value } right(value) { value + 10 } }
    } else {
        pick route { left(value) { value + 20 } right(value) { value + 30 } }
    })
    println(bump(pick route {
        left(value) { if flag { value } else { value + 1 } }
        right(value) { if flag { value + 2 } else { value + 3 } }
    }))
    println(take_byte(pick route { left(value) { 14 } right(value) { 15 } }))
    println(pick route { left(value) { mark(value) } right(value) { mark(value + 1) } })
}
fn direct_owned(flag: Bool) {
    val route: Route = if flag { left(1) } else { right(2) }
    println(pick route {
        left(value) { String.from("direct-borrow-left") }
        right(value) { String.from("direct-borrow-right") }
    })
    println(consume_text(pick route {
        left(value) { String.from("direct-consume-left") }
        right(value) { String.from("direct-consume-right") }
    }))
    println(consume_text(if flag {
        String.from("direct-if-left")
    } else {
        String.from("direct-if-right")
    }))
}
fn direct_never(flag: Bool) {
    println(if flag { return } else { 31 })
}
fn direct_pick_never(route: Route) {
    println(pick route { left(value) { return } right(value) { value } })
}
fn direct_all_never() {
    println(if true { return } else { return })
    println("unreachable-all-never")
}

fn tuple_value(value: (Int32, Int32)) -> Int32 {
    value.0 + value.1
}
fn array_value(value: Array[Int32, 2]) -> Int32 {
    value[0] + value[1]
}
fn print_scalar_ref(value: ref Int32) {
    println(if true { value } else { value })
}

shape Printer { value: Int32 }
implements Printer {
    fn println(self: ref, value: (Int32, Int32)) -> Int32 {
        value.0
    }
}
