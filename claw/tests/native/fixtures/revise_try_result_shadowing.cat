fn produce() -> Result[Int32, String] {
    return Ok(7)
}

fn fail_produce() -> Result[Int32, String] {
    return Fail(String.from("inner"))
}

fn read_failure() -> Int32 {
    val err: String = String.from("outer")
    val result = try fail_produce() else err {
        println(err.as_str())
        return 0
    }
    return result
}

fn main() -> Int32 {
    val number = 99
    if true {
        val number = try produce() else err {
            return 0
        }
        println(number)
    }
    println(number)
    println(read_failure())
    0
}
