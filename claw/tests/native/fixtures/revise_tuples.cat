choice Route {
    left
    right
}

fn typed_pair() -> (Int64, Int64) {
    (40, 2)
}

fn choose_if(flag: Bool) -> (Int64, Int64) {
    if flag {
        (1, 41)
    } else {
        (20, 22)
    }
}

fn choose_pick(route: Route) -> (Int64, Int64) {
    pick route {
        left {
            (10, 32)
        }
        right {
            (21, 21)
        }
    }
}

fn nested_pair() -> ((Int32, Int32), Int32) {
    ((1, 2), 40)
}

fn empty_unit() -> () {
    ()
}

fn sum_pair(pair: (Int64, Int64)) -> Int64 {
    pair.0 + pair.1
}

fn main() {
    val grouped = (20 + 22)
    val singleton: (Int32,) = (42,)
    val pair = typed_pair()
    val nested = nested_pair()
    val selected_if = choose_if(true)
    val selected_pick = choose_pick(left)
    val decimal = (1.5, 2.25)

    empty_unit()
    println(grouped)
    println(singleton.0)
    println(pair.0 + pair.1)
    println(sum_pair(pair))
    println(nested.0.1 + nested.1)
    println(selected_if.0 + selected_if.1)
    println(selected_pick.0 + selected_pick.1)
    if decimal.0 + decimal.1 == 3.75 {
        println("float-ok")
    }
}
