shape Config {
    host: Str
    port: Int32
}

static version: Str = "1.0.0"
static max_conn: Int32 = 1024
static enabled: Bool = true

implements Config {
    fn new(host: Str, port: Int32) -> Config {
        return Config { host: host, port: port }
    }

    fn describe(self: ref) -> ref Str {
        return self.host
    }
}

fn get_version() -> ref Str {
    return ref version
}

fn main() -> Int32 {
    val cfg = Config.new(version, max_conn)
    println(cfg.describe())
    println(enabled)
    return 0
}
