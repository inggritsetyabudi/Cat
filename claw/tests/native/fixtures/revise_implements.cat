shape Config {
    host: String
    port: Int32
}

implements Config {
    fn new(host: String, port: Int32) -> Config {
        return Config { host: host, port: port }
    }

    fn show_host(self: ref) {
        println(self.host.as_str())
    }
}

fn main() -> Int32 {
    val cfg = Config.new(String.from("localhost"), 8080)
    cfg.show_host()
    return 0
}
