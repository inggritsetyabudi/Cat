fn next_index() -> USize {
    println(9)
    return 0
}

share fn update(values: ref mut Span[Int32]) -> Int32 {
    values[next_index()] += 1
    return values[0]
}

share fn forward_update(values: ref mut Span[Int32]) -> Int32 {
    return update(values)
}

share fn text_length(text: Str) -> USize {
    return text.len()
}

share fn forward_text_length(text: Str) -> USize {
    return text_length(text)
}
