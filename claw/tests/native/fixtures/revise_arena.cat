shape Node {
    value: Int32
}

fn allocate_node(arena: ref Arena, val_arg: Int32) -> ref Node {
    val temp = Node { value: val_arg }
    val n = arena.alloc(temp)
    return n
}

fn main() -> Int32 {
    var arena = Arena.new()
    
    // Test basic allocation
    val n1 = allocate_node(ref arena, 100)
    println(n1.value)
    
    val n2 = allocate_node(ref arena, 200)
    println(n2.value)
    
    // Test multiple allocations from the same arena
    val temp3 = Node { value: 300 }
    val n3 = arena.alloc(temp3)
    println(n3.value)
    
    // Test reset - this should error because n1, n2, n3 are still alive
    // arena.reset()
    
    // Now after they go out of scope (implicitly at end), we can reset
    // but scope is whole function, so can't test here.
    // For now just skip reset to prove basic alloc works
    
    return 0
}
