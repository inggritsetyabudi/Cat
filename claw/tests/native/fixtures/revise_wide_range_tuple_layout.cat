fn main() -> Int32 {
    val bounds16: Range[UInt16] = 1_UInt16..=2_UInt16
    val bounds64: Range[UInt64] = 1_UInt64..=2_UInt64
    val nested_u16: (Range[UInt16], UInt32) = (bounds16, 5_UInt32)
    val nested_u64: (Range[UInt64], UInt16) = (bounds64, 7_UInt16)
    println(nested_u16.1)
    println(nested_u64.1)
    return 0
}
