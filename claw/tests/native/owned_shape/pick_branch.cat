shape S { left: String, right: String }
choice Route {
    left
    right
}
fn make() -> S { S { left: String.from("left"), right: String.from("right") } }
fn main() -> Int32 {
    val route: Route = left()
    val x = pick route {
        left { make().left }
        right { String.from("other") }
    }
    println(x.as_str())
    return 0
}
