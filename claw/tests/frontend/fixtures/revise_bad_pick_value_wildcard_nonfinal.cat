choice Route {
    left(value: Int32)
    right(value: Int32)
}

fn choose(route: Route) -> Int32 {
    pick route {
        left(value) {
            value
        }
        _ {
            0
        }
        right(value) {
            value
        }
    }
}

fn main() {
    println(choose(right(4)))
}
