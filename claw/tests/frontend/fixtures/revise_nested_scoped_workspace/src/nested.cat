share view shape Name[s] {
    text: ref[s] Str,
}

share fn identity_name(value: Name[borrow]) -> Name[borrow] {
    return value
}

share fn choose_name(left: Name[borrow], right: Name[borrow]) -> Name[borrow] {
    return left
}

share fn first_text(value: Name[borrow]) -> ref[borrow] Str {
    return value.text
}
