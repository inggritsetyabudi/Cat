import src.nested.{ Name, choose_name, first_text, identity_name }

fn main() {
    val source = "workspace"
    val second = "cross-module"
    scope actual {
        val name: Name[actual] = Name { text: ref[actual] source }
        val other: Name[actual] = Name { text: ref[actual] second }
        val same: Name[actual] = identity_name(name)
        val selected: Name[actual] = choose_name(same, other)
        val text: ref[actual] Str = first_text(selected)
        println(text)
    }
}
