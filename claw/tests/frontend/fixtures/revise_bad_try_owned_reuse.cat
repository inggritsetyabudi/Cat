fn make_anchor() -> Result[Anchor[String], String] {
    return Ok(Anchor.new(String.from("owned")))
}

fn consume_result(result: Result[Anchor[String], String]) {
    pick result {
        Ok(anchor) { println(anchor.get().as_str()) }
        Fail(error) { println(error.as_str()) }
    }
}

fn bad_reuse() {
    val result = make_anchor()
    val payload = try result else err {
        println(err.as_str())
        return
    }
    consume_result(result)
}

fn main() {
    bad_reuse()
}
