choice StableText {
    some(value: Anchor[String])
    none
}

fn print_value(value: StableText) {
    pick value {
        some(stable) {
            println(stable.get().as_str())
        }
        none {
            println("none")
        }
    }
}

fn main() {
    print_value(some(Anchor.new(String.from("choice"))))
    print_value(none)
}
