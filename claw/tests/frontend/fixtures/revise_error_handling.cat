
fn step(flag: Bool) -> Result[Int32, String] {
    if flag {
        return Ok(7)
    }
    return Fail(String.from("bad"))
}

fn unwrap(flag: Bool) -> Result[Int32, String] {
    val value = try step(flag)
    return Ok(value + 1)
}

fn show(flag: Bool) {
    val value = try step(flag) else err {
        println(err.as_str())
        return
    }
    println(value)
}

fn main() {
    show(true)
}
