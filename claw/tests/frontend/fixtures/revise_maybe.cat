
fn greet(name: Maybe[String]) -> String {
    pick name {
        Some(n) {
            return n
        }
        None {
            return String.from("world")
        }
    }
}

fn add_one(value: Maybe[Int32]) -> Int32 {
    pick value {
        Some(n) {
            return n + 1
        }
        None {
            return 0
        }
    }
}

fn main() {
    val a: Maybe[Int32] = Some(41)
    val b: Maybe[Int32] = None
    println(add_one(a))
    println(add_one(b))
    val greeting = greet(Some(String.from("C@")))
    println(greeting.as_str())
    val default_greeting = greet(None)
    println(default_greeting.as_str())
}
