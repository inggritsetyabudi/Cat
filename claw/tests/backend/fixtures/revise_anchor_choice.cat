choice StableText {
    some(value: Anchor[Str])
    none
}

fn print_value(value: StableText) {
    pick value {
        some(stable) {
            println(stable.get())
        }
        none {
            println("none")
        }
    }
}

fn main() {
    print_value(some(Anchor.new("choice")))
    print_value(none)
}