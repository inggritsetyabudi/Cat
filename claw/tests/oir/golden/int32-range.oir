oir.fn contains(value: Int32 [scalar], range: Range[Int32] [direct]) -> Int32 [scalar] [abi=claw link=internal symbol=revise_int32_range::contains ffi=false]
  block entry:
    %t0 = in value, range : Bool
    var %t1: Int32
    branch %t0 -> if_then_0, if_else_1
  block if_then_0:
    store %t1 <- 1 : Int32
    goto if_join_2
  block if_else_1:
    store %t1 <- 0 : Int32
    goto if_join_2
  block if_join_2:
    return %t1 : Int32
oir.fn combined_membership() -> Int32 [scalar] [abi=claw link=internal symbol=revise_int32_range::combined_membership ffi=false]
  block entry:
    %t0 = range_exclusive 1, 5 : Range[Int32]
    %t1 = in 3, %t0 : Bool
    var %t2: Bool
    branch %t1 -> logic_rhs_0, logic_short_1
  block logic_rhs_0:
    %t3 = range_inclusive 1, 4 : Range[Int32]
    %t4 = in 4, %t3 : Bool
    store %t2 <- %t4 : Bool
    goto logic_merge_2
  block logic_short_1:
    store %t2 <- false : Bool
    goto logic_merge_2
  block logic_merge_2:
    var %t5: Int32
    branch %t2 -> if_then_3, if_else_4
  block if_then_3:
    store %t5 <- 1 : Int32
    goto if_join_5
  block if_else_4:
    store %t5 <- 0 : Int32
    goto if_join_5
  block if_join_5:
    return %t5 : Int32
oir.fn parenthesized_membership() -> Int32 [scalar] [abi=claw link=internal symbol=revise_int32_range::parenthesized_membership ffi=false]
  block entry:
    %t0 = range_exclusive 1, 5 : Range[Int32]
    %t1 = in 9, %t0 : Bool
    var %t2: Bool
    branch %t1 -> logic_short_1, logic_rhs_0
  block logic_rhs_0:
    %t3 = range_inclusive 2, 4 : Range[Int32]
    %t4 = in 3, %t3 : Bool
    store %t2 <- %t4 : Bool
    goto logic_merge_2
  block logic_short_1:
    store %t2 <- true : Bool
    goto logic_merge_2
  block logic_merge_2:
    var %t5: Int32
    branch %t2 -> if_then_3, if_else_4
  block if_then_3:
    store %t5 <- 1 : Int32
    goto if_join_5
  block if_else_4:
    store %t5 <- 0 : Int32
    goto if_join_5
  block if_join_5:
    return %t5 : Int32
oir.fn start_once() -> Int32 [scalar] [abi=claw link=internal symbol=revise_int32_range::start_once ffi=false]
