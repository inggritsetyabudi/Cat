oir.module uint8-range-scan
oir.choice Result of T, E [abi=claw link=internal symbol=uint8-range-scan::Result ffi=false]
  layout repr=claw-internal kind=template size=0 align=4 pass=indirect ffi=false unresolved=true
  case Ok(T)
  case Fail(E)
oir.choice Maybe of T [abi=claw link=internal symbol=uint8-range-scan::Maybe ffi=false]
  layout repr=claw-internal kind=template size=0 align=4 pass=indirect ffi=false unresolved=true
  case None
  case Some(T)
oir.fn main() -> Int32 [scalar] [abi=claw link=internal symbol=uint8-range-scan::main ffi=false]
  block entry:
    %t0 = range_inclusive 0, 255_UInt8 : Range[UInt8]
    val whole: Range[UInt8] = %t0
    %t1 = range_inclusive 0, 255_UInt8 : Range[UInt8]
    range_scan_init item: UInt8 from %t1 : Range[UInt8]
    goto scan_header_0
  block scan_header_0:
    scan item: UInt8 over %t1 -> scan_body_1, scan_exit_2
  block scan_body_1:
    call println(item) : Unit
    goto scan_header_0
  block scan_exit_2:
    range_scan_init item: UInt8, index: USize from whole : Range[UInt8]
    goto scan_header_3
  block scan_header_3:
    scan item: UInt8, index: USize over whole -> scan_body_4, scan_exit_5
  block scan_body_4:
    call println(item) : Unit
    call println(index) : Unit
    goto scan_header_3
  block scan_exit_5:
    return 0 : integer literal
