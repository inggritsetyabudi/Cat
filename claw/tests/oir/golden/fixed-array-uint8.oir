oir.module fixed-array-uint8
oir.choice Result of T, E [abi=claw link=internal symbol=fixed-array-uint8::Result ffi=false]
  layout repr=claw-internal kind=template size=0 align=4 pass=indirect ffi=false unresolved=true
  case Ok(T)
  case Fail(E)
oir.choice Maybe of T [abi=claw link=internal symbol=fixed-array-uint8::Maybe ffi=false]
  layout repr=claw-internal kind=template size=0 align=4 pass=indirect ffi=false unresolved=true
  case None
  case Some(T)
oir.fn main() -> Int32 [scalar] [abi=claw link=internal symbol=fixed-array-uint8::main ffi=false]
  block entry:
    val %t0: Array[UInt8, 3]
    store_field %t0.0 <- 0_UInt8 : UInt8
    store_field %t0.1 <- 128_UInt8 : UInt8
    store_field %t0.2 <- 255_UInt8 : UInt8
    val inferred: Array[UInt8, 3] = %t0
    val %t1: Array[UInt8, 3]
    store_field %t1.0 <- 0 : UInt8
    store_field %t1.1 <- 128 : UInt8
    store_field %t1.2 <- 255 : UInt8
    val annotated: Array[UInt8, 3] = %t1
    %t2 = index inferred[1_USize] : UInt8
    call println(%t2) : Unit
    goto scan_header_0
  block scan_header_0:
    scan item: UInt8, index: USize over annotated -> scan_body_1, scan_exit_2
  block scan_body_1:
    call println(index) : Unit
    call println(item) : Unit
    goto scan_header_0
  block scan_exit_2:
    return 0 : Int32
