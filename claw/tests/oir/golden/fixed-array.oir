oir.module fixed-array
oir.choice Result of T, E [abi=claw link=internal symbol=fixed-array::Result ffi=false]
  layout repr=claw-internal kind=template size=0 align=4 pass=indirect ffi=false unresolved=true
  case Ok(T)
  case Fail(E)
oir.choice Maybe of T [abi=claw link=internal symbol=fixed-array::Maybe ffi=false]
  layout repr=claw-internal kind=template size=0 align=4 pass=indirect ffi=false unresolved=true
  case None
  case Some(T)
oir.fn main() -> Int32 [scalar] [abi=claw link=internal symbol=fixed-array::main ffi=false]
  block entry:
    val %t0: Array[Int32, 3]
    store_field %t0.0 <- 1 : Int32
    store_field %t0.1 <- 2 : Int32
    store_field %t0.2 <- 3 : Int32
    val inferred: Array[Int32, 3] = %t0
    val %t1: Array[Int32, 3]
    store_field %t1.0 <- 4 : Int32
    store_field %t1.1 <- 5 : Int32
    store_field %t1.2 <- 6 : Int32
    val annotated: Array[Int32, 3] = %t1
    %t2 = index inferred[1] : Int32
    call println(%t2) : Unit
    goto scan_header_0
  block scan_header_0:
    scan item: Int32, index: USize over annotated -> scan_body_1, scan_exit_2
  block scan_body_1:
    call println(index) : Unit
    call println(item) : Unit
    goto scan_header_0
  block scan_exit_2:
    return 0 : Int32
